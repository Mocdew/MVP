# Copy to .env and fill in. Never commit .env.

# Flask
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=1

# Database. SQLite for local dev; Postgres (Neon/Supabase) for deploy.
DATABASE_URL=sqlite:///dealdesk.db
# DATABASE_URL=postgresql+psycopg://user:pass@host/dbname

# OAuth tokens are encrypted at rest with this key.
# Generate one:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web application)
# Authorised redirect URI: http://localhost:5000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared secret for the cron-driven refresh endpoint (POST /internal/refresh)
INTERNAL_REFRESH_TOKEN=change-me-too
